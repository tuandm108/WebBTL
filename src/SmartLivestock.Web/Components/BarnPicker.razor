@using SmartLivestock.Contracts
@using System.Globalization
@using System.Text
@inject IHttpClientFactory ClientFactory

<div class="picker @(open ? "open" : "")">
    <div class="picker-field">
        <Icon Name="search" Size="16" />
        <input class="form-control" type="search" autocomplete="off" role="combobox"
               aria-expanded="@open" aria-controls="picker-panel" aria-label="Tìm và chọn chuồng giám sát"
               placeholder="Tìm chuồng theo tên hoặc mã để thêm vào giám sát…"
               value="@query" @oninput="OnInput" @onfocus="() => open = true" @onclick="() => open = true" @onkeydown="OnKey" />
    </div>
    <span class="picker-count num" role="status">Đang giám sát @selected / @all.Count chuồng</span>

    @if (open)
    {
        <div class="picker-backdrop" @onclick="() => open = false"></div>
        <div class="card-x picker-panel" id="picker-panel">
            @if (error is not null)
            {
                <div class="alert alert-warning m-2" role="alert">@error</div>
            }
            <div class="picker-actions">
                <button type="button" class="btn btn-ghost" disabled="@(results.Count == 0)" @onclick="() => SetAsync(results, true)">Chọn tất cả (@results.Count)</button>
                <button type="button" class="btn btn-ghost" disabled="@(results.Count == 0)" @onclick="() => SetAsync(results, false)">Bỏ chọn (@results.Count)</button>
            </div>
            @if (results.Count == 0)
            {
                <p class="empty m-0" role="status">Không tìm thấy chuồng nào khớp "@query".</p>
            }
            else
            {
                <ul class="picker-list" role="group" aria-label="Danh sách chuồng">
                    @foreach (var barn in results)
                    {
                        <li>
                            <label class="picker-item">
                                <input type="checkbox" class="form-check-input" checked="@barn.Monitored"
                                       @onchange="() => SetAsync(new[] { barn }, !barn.Monitored)" />
                                <span class="cell-name">@barn.Name<span class="cell-sub">@barn.Code</span></span>
                            </label>
                        </li>
                    }
                </ul>
            }
            <div class="picker-foot">
                <button type="button" class="btn btn-primary" @onclick="() => open = false">Xong</button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Raised after the monitored set changed on the server, so the page can reload its table.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<BarnDto> all = [];
    private string query = "";
    private bool open;
    private string? error;

    private int selected => all.Count(x => x.Monitored);
    private List<BarnDto> results => string.IsNullOrWhiteSpace(query)
        ? all
        : all.Where(x => Fold($"{x.Name} {x.Code}").Contains(Fold(query.Trim()))).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { all = await ClientFactory.CreateClient("api").GetFromJsonAsync<List<BarnDto>>("api/barns") ?? []; }
        catch (Exception ex) { error = $"Không thể tải danh sách chuồng: {ex.Message}"; }
    }

    private void OnInput(ChangeEventArgs e) { query = e.Value?.ToString() ?? ""; open = true; }

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") open = false; }

    private async Task SetAsync(IEnumerable<BarnDto> items, bool value)
    {
        var ids = items.Where(x => x.Monitored != value).Select(x => x.Id).ToList();
        if (ids.Count == 0) return;
        try
        {
            var response = await ClientFactory.CreateClient("api")
                .PutAsJsonAsync("api/barns/monitored", new MonitoredInput(ids, value));
            response.EnsureSuccessStatusCode();
            for (var i = 0; i < all.Count; i++)
                if (ids.Contains(all[i].Id)) all[i] = all[i] with { Monitored = value };
            error = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { error = $"Không thể cập nhật: {ex.Message}"; }
    }

    // Case- and accent-insensitive so "chuong 07" finds "Chuồng 07".
    private static string Fold(string text)
    {
        var decomposed = text.ToLowerInvariant().Replace('đ', 'd').Normalize(NormalizationForm.FormD);
        return new string(decomposed.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark).ToArray());
    }
}
