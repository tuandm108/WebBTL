@* Numbered pager: previous / first … window … last / next. Buttons are real <button>s, the current page is aria-current. *@
<nav class="pager-nav" aria-label="Phân trang">
    <button type="button" class="pg-btn pg-arrow" disabled="@(Page <= 1)" aria-label="Trang trước"
            @onclick="() => GoTo(Page - 1)"><Icon Name="chevron-left" Size="16" /></button>

    @if (WindowStart > 1)
    {
        <button type="button" class="pg-btn" @onclick="() => GoTo(1)">1</button>
        @if (WindowStart > 2) { <span class="pg-gap" aria-hidden="true">…</span> }
    }
    @for (var p = WindowStart; p <= WindowEnd; p++)
    {
        var target = p;
        <button type="button" class="pg-btn @(p == Page ? "on" : "")" aria-current="@(p == Page ? "page" : null)"
                aria-label="Trang @p" @onclick="() => GoTo(target)">@p</button>
    }
    @if (WindowEnd < Pages)
    {
        @if (WindowEnd < Pages - 1) { <span class="pg-gap" aria-hidden="true">…</span> }
        <button type="button" class="pg-btn" @onclick="() => GoTo(Pages)">@Pages</button>
    }

    <button type="button" class="pg-btn pg-arrow" disabled="@(Page >= Pages)" aria-label="Trang sau"
            @onclick="() => GoTo(Page + 1)"><Icon Name="chevron-right" Size="16" /></button>
</nav>

@code {
    private const int Visible = 5;

    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Pages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPage { get; set; }

    // Window of up to five page numbers centred on the current page.
    private int WindowEnd => Math.Min(Pages, Math.Max(1, Page - Visible / 2) + Visible - 1);
    private int WindowStart => Math.Max(1, WindowEnd - Visible + 1);

    private async Task GoTo(int target)
    {
        if (target < 1 || target > Pages || target == Page) return;
        await OnPage.InvokeAsync(target);
    }
}
